#gets quaternion for both imus, toggle sensorr fusion method
def get_q(imu_data, sf_method = "madgwick"): #(N, 9), xyz each for accelerometer, gyroscope, magnetometer
    #separate norms for sensor fusion
    a = np.linalg.norm(imu_data[:, 0:3])
    g = np.linalg.norm(imu_data[:, 3:6])
    m = np.linalg.norm(imu_data[:, 6:9])

    methods = {
        # 'kalman' : kalman,
        'madgwick' : madgwick,
        'mahony' : mahony
        # 'GI' : gyroscopic_integration,
        # 'AC': accelerometer_inclination,
        # 'BCF' : basic_complementary,
        # 'dmp' : digital_motion_processor
    }

    return methods[sf_method](a, g, m)

